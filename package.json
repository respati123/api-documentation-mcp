{
  "name": "api-documentation-mcp",
  "version": "0.4.0",
  "description": "Command-line and MCP access to the API Documentation desktop app: workspaces, collections, requests, environments, variables, and sending requests",
  "type": "module",
  "bin": {
    "api-documentation-mcp": "dist/index.js",
    "api-documentation": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "api-documentation",
    "cli"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\" --log-level=warning && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "test": "esbuild src/test/commands.test.ts src/test/guide.test.ts --bundle --platform=node --format=esm --target=node22 --outdir=.test-out --out-extension:.js=.mjs --log-level=warning && node --test .test-out/commands.test.mjs .test-out/guide.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
